# Переменные для docker compose. Подключение: source .env-latest
# TYPE — подкаталог Dockerfile в images/*/

export TELEGRAF_TAG=latest
export INFLUXDB_TAG=1.8
export CHRONOGRAF_TAG=latest
export KAPACITOR_TAG=latest
export TYPE=latest
# GID группы docker на хосте (getent group docker | cut -d: -f3)
export DOCKER_GID="$(getent group docker | cut -d: -f3)"
